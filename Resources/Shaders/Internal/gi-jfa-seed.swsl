preset raw;

uniform highp vec2 targetSize;

varying highp vec2 pos;

void vertex()
{
    VERTEX = apply_mvp(VERTEX);
    pos = (VERTEX + vec2(1.0)) / 2.0;
}

void fragment()
{
    highp float mask = zTexture(pos).r;

    if (mask > 0.5)
    {
        COLOR = vec4(pos, 1.0, 1.0);
    }
    else
    {
        COLOR = vec4(-1.0, -1.0, 0.0, 1.0);
    }
}
